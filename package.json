{
  "name": "aerosol-data-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:hero": "node scripts/build-static-hero-assets.mjs",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode pages",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:test": "vitest run tests/unit/stationDayWorker.test.ts tests/unit/stationDayHttp.test.ts",
    "worker:types": "wrangler types --config worker/wrangler.jsonc",
    "worker:dry-run": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "audit:privacy": "node --test scripts/check-private-paths.test.mjs && node scripts/check-private-paths.mjs",
    "audit:privacy:history": "node scripts/check-private-paths.mjs --history",
    "verify:public": "node --test scripts/check-public-release.test.mjs && npm run worker:dry-run && python -m unittest discover -s reference-python -p \"test_*.py\" && python -m pip_audit --strict --no-deps -r reference-python/requirements.txt && npm test && npm run audit:privacy && npm run audit:privacy:history && npm audit --omit=dev && npm run lint && npm run build",
    "verify:release": "npm run verify:public && npm run e2e",
    "lint": "tsc -b --pretty false",
    "preview": "vite preview",
    "e2e": "playwright test"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "9.3.4",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "wrangler": "4.120.0"
  }
}
